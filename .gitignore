# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.idea/
.vscode/
*.iml
*.g.dart
*.freezed.dart

# ...but the CAPTCHA glyph templates are generated offline and checked in, since
# the app cannot recognise a CAPTCHA without them and regenerating requires
# re-capturing live samples. Narrow negation, not a weakening of the rule above.
!lib/adapter/captcha_templates.g.dart

# Reconnaissance artifacts — NEVER commit: session cookies, viewstate dumps,
# CAPTCHA images, authenticated page snapshots may contain personal data.
recon/
# Live capture artifacts — same reason: authenticated page snapshots,
# viewstate dumps and session cookies.
captures/
*.pkl
auth_jar.txt
cookies.txt

# Probe output — scratch diagnostics from the read-only portal probes.
probe_*.txt
.probe_out.txt

# Analyzer and test transcripts, written during a session.
analyze_*.txt
*_test_out.txt
test_out.txt
t1.txt

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Gradle/Kotlin build noise
.gradle-build/
android/.kotlin/
*.log
